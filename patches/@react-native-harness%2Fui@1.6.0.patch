+#pragma mark - Long press (nitro-ui patch, docs/upstream.md H11)
+
+// A held press: `executeTapAtPoint:`'s private `UITouch` path, step for step, with the
+// touch kept down for `duration` instead of a tap's 50 ms and `isTap` off. UIKit's own
+// long-press recognizers (a `UIContextMenuInteraction`'s among them) run on timers, so
+// a touch that stays in `began` for the duration is a real hold to them.
+- (void)executeHoldAtPoint:(CGPoint)point
+                  duration:(NSTimeInterval)duration
+                completion:(void (^)(void))completion {
+  UIWindow *window = [self getActiveWindow];
+  if (!window) {
+    if (completion)
+      completion();
+    return;
+  }
+  UIView *targetView = [window hitTest:point withEvent:nil];
+  if (!targetView) {
+    if (completion)
+      completion();
+    return;
+  }
+  UIEvent *event = [[UIApplication sharedApplication] _touchesEvent];
+  [event _clearTouches];
+  if ([event respondsToSelector:@selector(_setHIDEvent:)]) {
+    [event _setHIDEvent:NULL];
+  }
+  dispatch_after(
+      dispatch_time(DISPATCH_TIME_NOW, (int64_t)(kSettleDelay * NSEC_PER_SEC)),
+      dispatch_get_main_queue(), ^{
+        UITouch *touch = [[UITouch alloc] init];
+        _touchIdCounter =
+            (_touchIdCounter >= UINT_MAX - 1) ? 100 : _touchIdCounter + 1;
+        if ([touch respondsToSelector:@selector(_setTouchIdentifier:)]) {
+          [touch _setTouchIdentifier:_touchIdCounter];
+        }
+        [touch setWindow:window];
+        [touch setView:targetView];
+        [touch setTapCount:1];
+        if ([touch respondsToSelector:@selector(_setIsFirstTouchForView:)]) {
+          [touch _setIsFirstTouchForView:YES];
+        }
+        if ([touch respondsToSelector:@selector(setIsTap:)]) {
+          [touch setIsTap:NO];
+        }
+        UIEvent *freshEvent = [[UIApplication sharedApplication] _touchesEvent];
+        [freshEvent _clearTouches];
+        [self sendTouchEvent:touch
+                       event:freshEvent
+                       phase:UITouchPhaseBegan
+                       point:point];
+        dispatch_after(
+            dispatch_time(DISPATCH_TIME_NOW, (int64_t)(duration * NSEC_PER_SEC)),
+            dispatch_get_main_queue(), ^{
+              UIEvent *endEvent =
+                  [[UIApplication sharedApplication] _touchesEvent];
+              [self sendTouchEvent:touch
+                             event:endEvent
+                             phase:UITouchPhaseEnded
+                             point:point];
+              [endEvent _clearTouches];
+              dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                           (int64_t)(kEventProcessingDelay *
+                                                     NSEC_PER_SEC)),
+                             dispatch_get_main_queue(), ^{
+                               if (completion)
+                                 completion();
+                             });
+            });
+      });
+}
+
+- (void)simulateLongPress:(NSString *)nativeId
+                        x:(double)x
+                        y:(double)y
+               durationMs:(double)durationMs
+                  resolve:(RCTPromiseResolveBlock)resolve
+                   reject:(RCTPromiseRejectBlock)reject {
+  dispatch_async(dispatch_get_main_queue(), ^{
+    CGPoint point = CGPointMake(x, y);
+    if (nativeId && nativeId.length > 0) {
+      UIView *view = [ViewRegistry getView:nativeId];
+      UIWindow *window = [self getActiveWindow];
+      if (view && !window) window = view.window;
+      if (view && window) {
+        CGRect frameInWindow = [view convertRect:view.bounds toView:window];
+        point = CGPointMake(CGRectGetMidX(frameInWindow), CGRectGetMidY(frameInWindow));
+      }
+    }
+    _lastTapTime = CACurrentMediaTime();
+    [self executeHoldAtPoint:point
+                    duration:MAX(durationMs, 0) / 1000.0
+                  completion:^{
+                    resolve(nil);
+                  }];
+  });
+}
