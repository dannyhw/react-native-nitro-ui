diff --git a/dist/emulator-startup.js b/dist/emulator-startup.js
index 33621b6ae4025988e08d0618c27ccf7490341d61..bdc442bd4282062e1105a27a5e267337e3c3f5cb 100644
--- a/dist/emulator-startup.js
