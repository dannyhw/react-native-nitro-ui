{
  "extends": "expo/tsconfig.base",
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts"],
  "exclude": ["node_modules", "../node_modules", "ios", "android", ".expo"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "types": ["react"],
    "skipLibCheck": true,
    "moduleSuffixes": [".ios", ""],
    "noEmit": true
  }
}
