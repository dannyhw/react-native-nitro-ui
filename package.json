{
  "name": "react-native-nitro-ui",
  "version": "0.3.1",
  "description": "Native SwiftUI and Jetpack Compose components for React Native, built on Nitro Modules",
  "type": "commonjs",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-nitro-ui-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "nitro-ui.sizing.json",
    "CHANGELOG.md",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/*.perf-test.*",
    "!android/src/test",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun --cwd example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "prepare": "bob build",
    "nitrogen": "nitrogen src && node scripts/patch-nitrogen.mjs",
    "nitrogen:check": "node scripts/nitrogen-check.mjs",
    "autolinking:check": "node scripts/check-autolinking.mjs",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:native": "bash scripts/native-tests.sh",
    "test:native:android": "bash scripts/native-tests-android.sh",
    "test:real-input:ios": "node scripts/real-input/ios.mjs",
    "test:real-input:android": "node scripts/real-input/android.mjs",
    "build:app": "node scripts/build-app.mjs",
    "lease": "node scripts/lease.mjs",
    "publint": "publint --strict",
    "manifest:check": "node scripts/package-files.mjs",
    "manifest:update": "node scripts/package-files.mjs --update",
    "check": "bun run typecheck && bun run bench:typecheck && bun run lint && bun run format && bun run test && bun run test:native && bun run perf:renders && bun run nitrogen:check && bun run autolinking:check && bun run prepare && bun run api-extractor:check && bun run publint && bun run manifest:check && bun run readme:check",
    "storybook": "bun --cwd example storybook",
    "storybook:ios": "bun --cwd example storybook:ios",
    "storybook:android": "bun --cwd example storybook:android",
    "storybook:generate": "bun --cwd example storybook:generate",
    "harness:ios": "bun --cwd example harness:ios",
    "harness:android": "bun --cwd example harness:android",
    "harness:cold:ios": "bun --cwd example harness:cold:ios",
    "harness:cold:android": "bun --cwd example harness:cold:android",
    "smoke:pack": "bash scripts/smoke/pack.sh",
    "smoke:expo": "bash scripts/smoke/expo.sh",
    "smoke:rn-cli": "bash scripts/smoke/rn-cli.sh",
    "bench": "node scripts/bench/run.mjs",
    "bench:report": "node scripts/bench/report.mjs",
    "bench:typecheck": "bun --cwd bench typecheck && bun --cwd bench typecheck:android",
    "probe:nitrogen": "bun --cwd bench/modules/bench-probe nitrogen",
    "perf:renders": "node scripts/perf/renders.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "api-extractor": "api-extractor run --local --config etc/api-extractor.json",
    "api-extractor:check": "api-extractor run --config etc/api-extractor.json",
    "readme:check": "node scripts/readme-examples-check.mjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "swiftui",
    "jetpack-compose",
    "compose",
    "nitro-modules",
    "nitro",
    "native-components",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyhw/react-native-nitro-ui.git"
  },
  "author": "Daniel Williams <me@dannyhw.com> (https://github.com/dannyhw)",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "bugs": {
    "url": "https://github.com/dannyhw/react-native-nitro-ui/issues"
  },
  "homepage": "https://github.com/dannyhw/react-native-nitro-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "ajv": "^8.17.1",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "nitrogen": "^0.37.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-test-renderer": "19.3.0",
    "reassure": "^1.6.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.86.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "workspaces": [
    ".",
    "example",
    "bench",
    "bench/modules/bench-probe"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-nitro-ui-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/bench/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/bench/",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "transform": {
      "^.+\\.(js|mjs|jsx|ts|tsx)$": "babel-jest",
      "^.+\\.(bmp|gif|jpg|jpeg|mp4|png|psd|svg|webp)$": "@react-native/jest-preset/jest/assetFileTransformer.js"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "unrs-resolver"
  ],
  "create-react-native-library": {
    "type": "nitro-view",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.64.0"
  },
  "sideEffects": false,
  "patchedDependencies": {
    "@react-native-harness/platform-apple@1.6.0": "patches/@react-native-harness%2Fplatform-apple@1.6.0.patch",
    "@react-native-harness/platform-android@1.6.0": "patches/@react-native-harness%2Fplatform-android@1.6.0.patch"
  }
}
