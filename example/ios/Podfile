# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NitroUiExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # C++/ObjC++ compiles go through ccache when it is installed. React Native
      # checks for the binary itself and only then sets CC/CXX, so on a machine
      # or CI runner without ccache this line changes nothing (X6-build-speed).
      :ccache_enabled => true
    )

    # ... but React Native writes those settings into *every* project it finds,
    # and one of the app project's build settings is then `CCACHE_BINARY` with a
    # path that belongs to one machine. That file is tracked, so the settings
    # come back out of here: the compiles worth caching are all in the Pods
    # project, which is not tracked, and they keep their launcher.
    ccache_keys = %w[CC CXX LD LDPLUSPLUS CCACHE_BINARY]
    installer.aggregate_targets
      .map(&:user_project)
      .uniq { |project| project.path }
      .each do |project|
        touched = false
        project.build_configurations.each do |configuration|
          ccache_keys.each do |key|
            touched = true unless configuration.build_settings[key].nil?
            configuration.build_settings.delete(key)
          end
        end
        project.save if touched
      end
  end
end
