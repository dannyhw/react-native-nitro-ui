{
  "name": "react-native-nitro-ui-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "harness": "react-native-harness",
    "harness:ios": "react-native-harness --harnessRunner ios",
    "harness:android": "react-native-harness --harnessRunner android",
    "harness:cold:ios": "react-native-harness --harnessRunner ios ColdSizing",
    "harness:cold:android": "react-native-harness --harnessRunner android ColdSizing"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-harness/platform-android": "1.6.0",
    "@react-native-harness/platform-apple": "1.6.0",
    "@react-native-harness/ui": "1.6.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-harness": "1.6.0",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
