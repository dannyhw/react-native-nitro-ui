{
  "cxxNamespace": [
    "nitroui"
  ],
  "ios": {
    "iosModuleName": "NitroUi"
  },
  "android": {
    "androidNamespace": [
      "nitroui"
    ],
    "androidCxxLibName": "nitroui"
  },
  "autolinking": {
    "NitroUiCore": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNitroUiCore"
      }
    },
    "NitroUiSwitch": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroUiSwitch"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroUiSwitch"
      }
    }
  },
  "ignorePaths": [
    "node_modules",
    "example",
    "bench",
    "lib",
    "dist",
    "docs",
    "scripts",
    "patches"
  ]
}
